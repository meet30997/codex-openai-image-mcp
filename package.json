{
  "name": "codex-openai-image-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude and other AI agents generate, edit and make matching sets of images, using the Codex CLI (your ChatGPT plan, no API key) or the OpenAI Images API.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "image-generation",
    "codex",
    "openai",
    "gpt-image",
    "claude",
    "claude-code",
    "ai-images"
  ],
  "author": "meet30997",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meet30997/codex-openai-image-mcp.git"
  },
  "homepage": "https://github.com/meet30997/codex-openai-image-mcp#readme",
  "bugs": {
    "url": "https://github.com/meet30997/codex-openai-image-mcp/issues"
  },
  "type": "module",
  "bin": {
    "codex-openai-image-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openai": "^7.45.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
